# ── Supabase ──────────────────────────────
# Supabase 프로젝트 API 엔드포인트. 로컬(Docker)과 클라우드 값이 다르니 환경별로 구분해서 넣을 것
SUPABASE_URL=

# 클라이언트(프론트엔드)에서 쓰는 공개용 키. RLS 정책이 실제 보안을 담당하므로 노출돼도 비교적 안전하지만 커밋은 금지
SUPABASE_PUBLISHABLE_KEY=

# RLS를 우회하는 관리자 권한 키. 근로표 자동 생성 같은 백엔드 전용 로직에서만 사용. 프론트엔드 코드에 절대 노출 금지
SUPABASE_SECRET_KEY=

# Docker 로컬 Postgres 접속 비밀번호. supabase CLI가 `supabase start` 실행 시 자동 생성/출력함 (로컬 전용)
SUPABASE_DB_PASSWORD=

# ── 앱 설정 ──────────────────────────────
# 현재 실행 환경 구분용 커스텀 값 (local / production). 이 값에 따라 위 URL·키를 다르게 로드하도록 코드에서 분기 가능
APP_ENV=