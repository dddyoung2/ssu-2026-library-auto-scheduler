# 로컬에서는 비워 두면 SQLite(data/app.db)를 사용합니다.
# 실제 OT/배포에서는 PostgreSQL(Supabase 등) 연결 문자열 사용을 권장합니다.
DATABASE_URL=
SESSION_SECRET=change-this-to-a-long-random-string
COOKIE_SECURE=false

# 관리자 로그인은 기본적으로 data/admins.csv 파일을 사용합니다.
# 아래 값은 admins.csv가 없거나 활성 계정이 하나도 없을 때만 fallback으로 사용됩니다.
ADMIN_ID=admin01
ADMIN_PASSWORD=change-admin1-password
ADMIN2_ID=admin02
ADMIN2_PASSWORD=change-admin2-password
